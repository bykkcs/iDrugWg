<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tv_margin_large"
    android:layout_marginBottom="@dimen/tv_margin_large"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/tv_card_bg"
    app:stateListAnimator="@animator/focus_scale"
    app:cardStrokeWidth="@dimen/tv_card_stroke"
    app:cardStrokeColor="@color/plain_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/tv_padding_large">

        <TextView
            android:id="@+id/config_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/plain_black"
            android:textSize="@dimen/tv_font_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
