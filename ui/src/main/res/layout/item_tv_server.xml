<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/server_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/tv_card_spacing"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_server_card"
    android:stateListAnimator="@animator/focus_scale"
    app:cardElevation="@dimen/tv_card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/tv_padding">

        <TextView
            android:id="@+id/server_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/tv_medium_text"
            android:textColor="@color/tv_black_text"
            android:text="Server" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:background="@drawable/bg_tv_button"
            android:stateListAnimator="@animator/focus_scale"
            android:textSize="@dimen/tv_medium_text"
            android:focusable="false"
            android:clickable="false" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
